{
  "manifest_version": 3,
  "name": "OmniDash Workspace",
  "version": "4.0",
  "description": "Quản lý Không gian làm việc, Ghi chú, Tác vụ và Nhắc nhở",
  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mở OmniDash Side Panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["content.js"]
    }
  ]
}