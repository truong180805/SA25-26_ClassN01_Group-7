// prisma/schema.prisma

// 1. Client Generator
generator client {
  provider = "prisma-client-js"
}

// 2. Database Connection
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

// 3. Enums (Danh sách các giá trị cố định)
enum ActiveMode {
  work
  personal
  chill
}

enum TaskStatus {
  todo
  in_progress
  done
  archived
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

// 4. Models (Các bảng trong Database)

model User {
  id           String     @id @default(uuid()) @map("user_id")
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.Text
  fullName     String?    @map("full_name") @db.VarChar(200)
  avatarUrl    String?    @map("avatar_url") @db.Text
  activeMode   ActiveMode @default(work) @map("active_mode")
  timezone     String?    @db.VarChar(50)
  resetToken   String?    @db.Text
  resetTokenExp DateTime?

  role          Role      @default(USER)
  
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relationships (Liên kết dữ liệu)
  workspaces Workspace[]
  tasks      Task[]
  projects   Project[]
  notes      Note[]
  reminders  Reminder[]

  @@map("users") // Đổi tên bảng trong PostgreSQL thành 'users'
}

model Workspace {
  id          String         @id @default(uuid())
  
  // FIX LỖI 1: Khai báo relation trỏ ngược về User
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String         // Tên không gian (VD: "Môi trường Code Frontend")
  icon        String?        @default("Briefcase") // Icon đại diện
  color       String?        @default("#3b82f6")   // Màu sắc phân biệt
  
  // Quan hệ: Một Workspace chứa nhiều Tab
  tabs        WorkspaceTab[]
  
  // Quan hệ: Một Workspace có thể được dùng cho nhiều Task hoặc Project
  tasks       Task[]
  projects    Project[]
  notes       Note[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model WorkspaceTab {
  id          String         @id @default(uuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  title       String         // Tên của trang web (VD: "Figma - Design")
  url         String         @db.Text // Đường dẫn (Lưu @db.Text vì URL có thể rất dài)
  favicon     String?        @db.Text // Logo của trang web (tuỳ chọn)
  orderIndex  Int            @default(0) // Thứ tự mở tab (1, 2, 3...)
}

// --- BẢNG 1: CÔNG VIỆC LỚN (PROJECT) ---
model Project {
  id          String @id @default(uuid())
  
  userId      String
  user        User   @relation(fields: [userId], references: [id])

  workspaceId String? // Có thể gán vào 1 Workspace Combo (Tùy chọn)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  title       String
  content     String?   @db.Text
  startDate   DateTime?
  endDate     DateTime? // Ngày kết thúc/Đến hạn
  progress    Int       @default(0)
  viewType    String    @default("list") // Loại cài đặt: "list" hoặc "sequence" (sơ đồ)
  isStrictSequence Boolean @default(false)

  tasks Task[] // Chứa nhiều nhiệm vụ bên trong

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- BẢNG 2: NHIỆM VỤ CHI TIẾT (TASK) ---
model Task {
  id          String  @id @default(uuid())
  
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade) 

  userId      String
  user        User    @relation(fields: [userId], references: [id])

  // FIX LỖI 2: Khai báo relation trỏ ngược về Workspace
  workspaceId String? 
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  title       String
  content     String?   @db.Text
  priority    String    @default("medium")
  isPinned    Boolean   @default(false)
  startDate   DateTime?
  endDate     DateTime?
  isCompleted Boolean   @default(false) 
  attachment  String? 

  // Đệ quy: Sub-task (nhiệm vụ con của nhiệm vụ này)
  parentId    String?
  parent      Task?     @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subTasks    Task[]    @relation("TaskHierarchy")

  dependsOnId String?
  dependsOn   Task?     @relation("TaskSequence", fields: [dependsOnId], references: [id])
  nextTasks   Task[]    @relation("TaskSequence")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id        String   @id @default(uuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  
  title     String
  content   String   @db.Text
  url       String?  @db.Text   // Lưu lại đường dẫn trang web nếu note bằng Extension
  color     String?  @default("#fef08a") // Màu nền giao diện (VD: Vàng, Xanh, Hồng kiểu Sticky Note)
  isPinned  Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reminder {
  id        String   @id @default(uuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String
  icon      String?  @default("🔔")
  color     String?  @default("#3b82f6")
  interval  Int      // Số phút đếm ngược (VD: 20, 60, 120...)
  isActive  Boolean  @default(true) // Công tắc bật/tắt nhắc nhở
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}