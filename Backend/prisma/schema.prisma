// prisma/schema.prisma

// 1. Client Generator
generator client {
  provider = "prisma-client-js"
}

// 2. Database Connection
datasource db {
  provider = "postgresql"
}

// 3. Enums (Danh sách các giá trị cố định)
enum ActiveMode {
  work
  personal
  chill
}

enum TaskStatus {
  todo
  in_progress
  done
  archived
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

// 4. Models (Các bảng trong Database)

model User {
  id           String     @id @default(uuid()) @map("user_id")
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.Text
  fullName     String?    @map("full_name") @db.VarChar(200)
  avatarUrl    String?    @map("avatar_url") @db.Text
  activeMode   ActiveMode @default(work) @map("active_mode")
  timezone     String?    @db.VarChar(50)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relationships (Liên kết dữ liệu)
  workspaces Workspace[]
  tasks      Task[]
  projects   Project[]

  @@map("users") // Đổi tên bảng trong PostgreSQL thành 'users'
}

model Workspace {
  id          String     @id @default(uuid()) @map("workspace_id")
  userId      String     @map("user_id")
  name        String     @db.VarChar(200)
  icon        String?    @db.VarChar(50)
  description String?    @db.Text
  modeType    ActiveMode @map("mode_type")
  isFavorite  Boolean    @default(false) @map("is_favorite")
  createdAt   DateTime   @default(now()) @map("created_at")

  // Relationships
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  @@map("workspaces")
}

// --- BẢNG 1: CÔNG VIỆC LỚN (PROJECT) ---
// Tương ứng với danh sách hiển thị bên ngoài
model Project {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  workspaceId String? // Có thể gán vào 1 Workspace Combo (Tùy chọn)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  title     String
  content   String?   @db.Text
  startDate DateTime?
  endDate   DateTime? // Ngày kết thúc/Đến hạn
  progress  Int       @default(0)
  viewType  String    @default("list") // Loại cài đặt: "list" hoặc "sequence" (sơ đồ)
  isStrictSequence Boolean @default(false)

  tasks Task[] // Chứa nhiều nhiệm vụ bên trong

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- BẢNG 2: NHIỆM VỤ CHI TIẾT (TASK) ---
// Nằm bên trong 1 Project cụ thể
model Task {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade) // Xóa công việc thì xóa luôn task

  userId String

  user User @relation(fields: [userId], references: [id])

  workspaceId String? // Có thể gán vào 1 Workspace cụ thể

  title       String
  content     String?   @db.Text
  priority    String    @default("medium")
  isPinned    Boolean   @default(false)
  startDate   DateTime?
  endDate     DateTime?
  isCompleted Boolean   @default(false) // Tích hoàn thành
  attachment  String? // Link file/minh chứng đính kèm (URL)

  // Đệ quy: Sub-task (nhiệm vụ con của nhiệm vụ này)
  parentId String?
  parent   Task?   @relation("TaskToSubTask", fields: [parentId], references: [id], onDelete: Cascade)
  subTasks Task[]  @relation("TaskToSubTask")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
